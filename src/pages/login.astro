<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EduPlatform | Iniciar Sesión</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; }

        body {
            min-height: 100vh;
            display: flex;
            background: #f5f6fa;
        }

        .left-panel {
            width: 50%;
            background: linear-gradient(135deg, #1e1e2d 0%, #2d1b3d 50%, #1a1a2e 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 60px;
            position: relative;
            overflow: hidden;
        }

        .left-panel::before {
            content: '';
            position: absolute;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(233,69,96,0.15) 0%, transparent 70%);
            top: -100px;
            right: -100px;
        }

        .left-panel::after {
            content: '';
            position: absolute;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(233,69,96,0.1) 0%, transparent 70%);
            bottom: -50px;
            left: -50px;
        }

        .brand {
            text-align: center;
            z-index: 1;
        }

        .brand-logo {
            width: 70px;
            height: 70px;
            background: linear-gradient(135deg, #e94560, #c62a47);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
            font-size: 2rem;
            box-shadow: 0 10px 30px rgba(233,69,96,0.4);
        }

        .brand h1 {
            font-size: 2rem;
            font-weight: 700;
            color: white;
            margin-bottom: 12px;
        }

        .brand h1 span { color: #e94560; }

        .brand p {
            color: rgba(255,255,255,0.5);
            font-size: 0.95rem;
            line-height: 1.6;
            max-width: 300px;
        }

        .features {
            margin-top: 48px;
            z-index: 1;
            width: 100%;
            max-width: 320px;
        }

        .feature-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px 0;
            border-bottom: 1px solid rgba(255,255,255,0.07);
        }

        .feature-item:last-child { border-bottom: none; }

        .feature-icon {
            width: 36px;
            height: 36px;
            background: rgba(233,69,96,0.15);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .feature-item span {
            color: rgba(255,255,255,0.6);
            font-size: 0.875rem;
        }

        .right-panel {
            width: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 60px;
        }

        .login-box {
            width: 100%;
            max-width: 400px;
        }

        .login-box h2 {
            font-size: 1.6rem;
            font-weight: 700;
            color: #1e1e2d;
            margin-bottom: 8px;
        }

        .login-box p {
            color: #9ca3af;
            font-size: 0.875rem;
            margin-bottom: 36px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            font-size: 0.82rem;
            font-weight: 500;
            color: #374151;
            margin-bottom: 8px;
        }

        .input-wrapper {
            position: relative;
        }

        .input {
            width: 100%;
            padding: 12px 16px;
            border: 1.5px solid #e9ecef;
            border-radius: 10px;
            font-size: 0.875rem;
            outline: none;
            color: #1e1e2d;
            transition: border 0.2s, box-shadow 0.2s;
            background: white;
        }

        .input:focus {
            border-color: #e94560;
            box-shadow: 0 0 0 3px rgba(233,69,96,0.1);
        }

        .btn-login {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #e94560, #c62a47);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            margin-top: 8px;
            box-shadow: 0 4px 15px rgba(233,69,96,0.3);
        }

        .btn-login:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(233,69,96,0.4);
        }

        .btn-login:active { transform: translateY(0); }

        .mensaje-error {
            background: #fde8ec;
            color: #e94560;
            padding: 12px 16px;
            border-radius: 10px;
            font-size: 0.82rem;
            margin-bottom: 16px;
            display: none;
        }

        .divider {
            text-align: center;
            color: #d1d5db;
            font-size: 0.82rem;
            margin: 24px 0;
            position: relative;
        }

        .divider::before, .divider::after {
            content: '';
            position: absolute;
            top: 50%;
            width: 42%;
            height: 1px;
            background: #e9ecef;
        }

        .divider::before { left: 0; }
        .divider::after { right: 0; }

        .footer-text {
            text-align: center;
            color: #9ca3af;
            font-size: 0.78rem;
            margin-top: 32px;
}

.btn-registro {
    display: block;
    width: 100%;
    padding: 13px;
    background: white;
    color: #1e1e2d !important;
    border: 1.5px solid #e9ecef;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    text-align: center;
    text-decoration: none !important;
    margin-top: 4px;
}

.btn-registro:hover {
    border-color: #e94560;
    color: #e94560 !important;
    background: #fde8ec;
}
    </style>
</head>
<body>

    <!-- PANEL IZQUIERDO -->
    <div class="left-panel">
        <div class="brand">
            <div class="brand-logo">🎓</div>
            <h1>Edu<span>Platform</span></h1>
            <p>Plataforma de educación en línea para el aprendizaje del futuro</p>
        </div>

        <div class="features">
            <div class="feature-item">
                <div class="feature-icon">📚</div>
                <span>Gestión completa de cursos y profesores</span>
            </div>
            <div class="feature-item">
                <div class="feature-icon">📊</div>
                <span>Reportes y estadísticas en tiempo real</span>
            </div>
            <div class="feature-item">
                <div class="feature-icon">⭐</div>
                <span>Calificaciones y comentarios de usuarios</span>
            </div>
            <div class="feature-item">
                <div class="feature-icon">🎓</div>
                <span>Certificados automáticos al completar cursos</span>
            </div>
        </div>
    </div>

    <!-- PANEL DERECHO -->
    <div class="right-panel">
        <div class="login-box">
            <h2>Bienvenido de vuelta</h2>
            <p>Inicia sesión en tu panel de administración</p>

            <div id="mensaje-error" class="mensaje-error"></div>

            <div class="form-group">
                <label>Correo electrónico</label>
                <div class="input-wrapper">
                    <input type="email" id="correo" class="input" placeholder="admin@eduplatform.com">
                </div>
            </div>

            <div class="form-group">
                <label>Contraseña</label>
                <div class="input-wrapper" style="position:relative">
                    <input type="password" id="contrasena" class="input" placeholder="••••••••" style="padding-right:80px">
                    <button type="button" onclick="toggleLoginPassword()" style="position:absolute;right:14px;top:50%;transform:translateY(-50%);background:none;border:none;color:#9ca3af;cursor:pointer;font-size:0.82rem;font-weight:500" id="toggle-btn">Mostrar</button>
                </div>
            </div>

            <button class="btn-login" onclick="iniciarSesion()">
                Iniciar Sesión
            </button>

            <div class="divider">¿Eres estudiante?</div>
            <a href="/registro" class="btn-registro">Crear cuenta de estudiante</a>
<p class="footer-text">EduPlatform © 2024 — Solo acceso autorizado</p>
            </div>
        </div>
    </div>

</body>

</body>
</html>

<script>
    (window as any).toggleLoginPassword = toggleLoginPassword;
    
    function toggleLoginPassword() {
    const input = document.getElementById('contrasena') as HTMLInputElement;
    const btn = document.getElementById('toggle-btn')!;
    if (input.type === 'password') {
        input.type = 'text';
        btn.textContent = 'Ocultar';
    } else {
        input.type = 'password';
        btn.textContent = 'Mostrar';
    }
}
    (window as any).iniciarSesion = iniciarSesion;

    // Enter para hacer login
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') iniciarSesion();
    });

   async function iniciarSesion() {
    const correo = (document.getElementById('correo') as HTMLInputElement).value.trim();
    const contrasena = (document.getElementById('contrasena') as HTMLInputElement).value;
    const errorDiv = document.getElementById('mensaje-error')!;

    errorDiv.style.display = 'none';

    if (!correo || !contrasena) {
        errorDiv.textContent = 'Por favor completa todos los campos';
        errorDiv.style.display = 'block';
        return;
    }

    try {
        const res = await fetch('/php/login.php', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ correo, contrasena })
        });
        const data = await res.json();

        if (data.success) {
            if (data.rol === 'admin') {
                // Es administrador
                sessionStorage.setItem('admin', JSON.stringify(data.admin));
                window.location.href = '/admin';
            } else if (data.rol === 'cliente') {
                // Es cliente — Gamboa manejará esta ruta
                sessionStorage.setItem('usuario', JSON.stringify(data.usuario));
                window.location.href = '/cliente';
            }
        } else {
            errorDiv.textContent = data.mensaje || 'Credenciales incorrectas';
            errorDiv.style.display = 'block';
        }
    } catch(e) {
        errorDiv.textContent = 'Error de conexión con el servidor';
        errorDiv.style.display = 'block';
    }
}
</script>