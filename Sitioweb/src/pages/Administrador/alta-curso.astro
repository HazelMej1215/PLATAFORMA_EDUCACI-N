<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alta de Curso | Administrador</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            background: #f1f5f9;
        }
        .sidebar {
            width: 280px;
            background: #0f172a;
            color: #e2e8f0;
            position: fixed;
            height: 100vh;
            padding: 1.5rem;
            overflow-y: auto;
        }
        .sidebar h2 { font-size: 1.25rem; margin-bottom: 2rem; }
        .sidebar a {
            display: block;
            color: #cbd5e1;
            padding: 0.75rem 1rem;
            margin-bottom: 0.5rem;
            border-radius: 0.75rem;
            text-decoration: none;
        }
        .sidebar a:hover { background: #1e293b; color: white; }
        .main { margin-left: 280px; padding: 2rem; }
        .card {
            background: white;
            border-radius: 1.5rem;
            padding: 2rem;
            max-width: 800px;
            margin: 0 auto;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        }
        h2 { font-size: 1.5rem; margin-bottom: 0.5rem; }
        .sub { color: #64748b; margin-bottom: 1.5rem; font-size: 0.9rem; }
        .form-group { margin-bottom: 1.5rem; }
        label { display: block; font-weight: 500; margin-bottom: 0.5rem; }
        input, select, textarea {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            font-size: 0.95rem;
            background: #f8fafc;
        }
        textarea { min-height: 80px; resize: vertical; }
        .video-item {
            background: #f8fafc;
            border-radius: 1rem;
            padding: 1rem;
            margin-bottom: 1rem;
            border: 1px solid #e2e8f0;
        }
        .add-video { background: #10b981; margin: 0.5rem 0 1rem; }
        button {
            width: 100%;
            padding: 0.85rem;
            background: #4f46e5;
            color: white;
            border: none;
            border-radius: 1rem;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
        }
        button:hover { opacity: 0.9; }
        .add-video:hover { background: #059669; }
        .image-preview {
            width: 100%;
            max-height: 200px;
            object-fit: contain;
            margin-top: 0.5rem;
            border-radius: 0.5rem;
        }
        .msg { margin-top: 1rem; padding: 0.75rem; border-radius: 1rem; text-align: center; display: none; }
        .success { background: #d1fae5; color: #065f46; display: block; }
        .error { background: #fee2e2; color: #b91c1c; display: block; }
        @media (max-width: 768px) {
            .sidebar {
                width: 100%;
                height: auto;
                position: relative;
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
                padding: 1rem;
            }
            .sidebar a { display: inline-block; margin: 0 0.25rem; }
            .main { margin-left: 0; padding: 1rem; }
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <h2>Administrador</h2>
        <a href="/Administrador/dashboard">Inicio</a>
        <a href="/Administrador/alta-profesor">Alta Profesor</a>
        <a href="/Administrador/alta-curso">Alta Curso</a>
        <a href="/Administrador/visualizaciones">Visualizaciones</a>
        <a href="/Administrador/calificaciones">Calificaciones</a>
        <a href="/Administrador/reportes">Reportes</a>
        <a href="/api.php?action=logout">Cerrar sesión</a>
    </div>
    <div class="main">
        <div class="card">
            <h2>Crear nuevo curso</h2>
            <p class="sub">Completa la información del curso y sus lecciones</p>
            <form id="formCurso">
                <div class="form-group">
                    <label>Nombre del curso *</label>
                    <input type="text" name="nombre_curso" required>
                </div>
                <div class="form-group">
                    <label>Descripción del curso</label>
                    <textarea name="descripcion_curso"></textarea>
                </div>
                <div class="form-group">
                    <label>Imagen del curso (opcional)</label>
                    <input type="file" id="imagenCurso" accept="image/jpeg,image/png,image/jpg">
                    <div id="previewContainer" style="display:none;">
                        <img id="imgPreview" class="image-preview">
                        <button type="button" id="clearImagen" style="margin-top:0.5rem; background:#ef4444;">Eliminar imagen</button>
                    </div>
                    <small>Formato JPG/PNG, máx 2MB. Si no se sube, se usará un icono por defecto.</small>
                </div>
                <div class="form-group">
                    <label>Profesor *</label>
                    <select name="profesor_id" id="profesorSelect" required>
                        <option value="">Seleccione profesor</option>
                    </select>
                </div>
                <label>Lecciones del curso</label>
                <div id="videosContainer">
                    <div class="video-item">
                        <input type="text" name="video_titulo[]" placeholder="Título del video 1" required>
                        <textarea name="video_descripcion[]" placeholder="Breve descripción"></textarea>
                        <input type="text" name="video_url[]" placeholder="URL del video (YouTube, Vimeo)" required>
                    </div>
                </div>
                <button type="button" class="add-video" id="agregarVideo">+ Agregar otra lección</button>
                <button type="submit">Guardar curso</button>
                <div id="mensaje" class="msg"></div>
            </form>
        </div>
    </div>

    <script>
        let imagenBase64 = null;

        async function verificarSesionAdmin() {
            const resp = await fetch('/api.php?action=verificar_sesion', { credentials: 'include' });
            const data = await resp.json();
            if (!data.logged || data.rol !== 'admin') {
                window.location.href = '/';
                return false;
            }
            return true;
        }

        async function cargarProfesores() {
            const resp = await fetch('/api.php?action=listar_profesores', { credentials: 'include' });
            const data = await resp.json();
            const select = document.getElementById('profesorSelect');
            if (data.success) {
                data.profesores.forEach(p => {
                    const option = document.createElement('option');
                    option.value = p.id;
                    option.textContent = `${p.nombre} - ${p.especialidad}`;
                    select.appendChild(option);
                });
            }
        }

        // Previsualizar imagen
        document.getElementById('imagenCurso').addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (!file) return;
            if (!file.type.startsWith('image/')) {
                mostrarMensaje('Solo se permiten imágenes', 'error');
                return;
            }
            if (file.size > 2 * 1024 * 1024) {
                mostrarMensaje('La imagen no debe superar los 2MB', 'error');
                return;
            }
            const reader = new FileReader();
            reader.onloadend = () => {
                imagenBase64 = reader.result;
                document.getElementById('imgPreview').src = imagenBase64;
                document.getElementById('previewContainer').style.display = 'block';
            };
            reader.readAsDataURL(file);
        });

        document.getElementById('clearImagen').addEventListener('click', () => {
            imagenBase64 = null;
            document.getElementById('imagenCurso').value = '';
            document.getElementById('previewContainer').style.display = 'none';
        });

        // Agregar video
        document.getElementById('agregarVideo').addEventListener('click', () => {
            const container = document.getElementById('videosContainer');
            const index = container.children.length;
            const div = document.createElement('div');
            div.className = 'video-item';
            div.innerHTML = `
                <input type="text" name="video_titulo[]" placeholder="Título del video ${index+1}" required>
                <textarea name="video_descripcion[]" placeholder="Breve descripción"></textarea>
                <input type="text" name="video_url[]" placeholder="URL del video (YouTube, Vimeo)" required>
            `;
            container.appendChild(div);
        });

        // Enviar formulario
        const form = document.getElementById('formCurso');
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(form);
            const titulos = formData.getAll('video_titulo[]');
            const descripciones = formData.getAll('video_descripcion[]');
            const urls = formData.getAll('video_url[]');
            if (titulos.length === 0) {
                mostrarMensaje('Debe agregar al menos una lección', 'error');
                return;
            }
            for (let i = 0; i < titulos.length; i++) {
                if (!titulos[i].trim() || !urls[i].trim()) {
                    mostrarMensaje(`Complete título y URL del video ${i+1}`, 'error');
                    return;
                }
            }
            const videos = titulos.map((tit, idx) => ({
                titulo: tit,
                descripcion: descripciones[idx] || '',
                url: urls[idx]
            }));
            const payload = {
                nombre_curso: formData.get('nombre_curso'),
                descripcion_curso: formData.get('descripcion_curso') || '',
                profesor_id: formData.get('profesor_id'),
                videos: videos,
                imagen: imagenBase64 || null
            };
            try {
                const resp = await fetch('/api.php?action=alta_curso', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload),
                    credentials: 'include'
                });
                const data = await resp.json();
                if (data.success) {
                    mostrarMensaje('Curso creado con éxito', 'success');
                    form.reset();
                    imagenBase64 = null;
                    document.getElementById('previewContainer').style.display = 'none';
                    document.getElementById('videosContainer').innerHTML = `
                        <div class="video-item">
                            <input type="text" name="video_titulo[]" placeholder="Título del video 1" required>
                            <textarea name="video_descripcion[]" placeholder="Breve descripción"></textarea>
                            <input type="text" name="video_url[]" placeholder="URL del video (YouTube, Vimeo)" required>
                        </div>
                    `;
                } else {
                    mostrarMensaje(data.message || 'Error al crear curso', 'error');
                }
            } catch (error) {
                mostrarMensaje('Error de conexión', 'error');
            }
        });

        function mostrarMensaje(texto, tipo) {
            const msgDiv = document.getElementById('mensaje');
            msgDiv.textContent = texto;
            msgDiv.className = `msg ${tipo}`;
            setTimeout(() => {
                msgDiv.className = 'msg';
                msgDiv.style.display = 'none';
            }, 4000);
        }

        verificarSesionAdmin();
        cargarProfesores();
    </script>
</body>
</html>