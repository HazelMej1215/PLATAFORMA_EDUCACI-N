<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alta de Curso</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #f1f5f9;
        }
        .sidebar {
            width: 280px;
            background: #0f172a;
            color: #e2e8f0;
            position: fixed;
            height: 100vh;
            padding: 1.5rem;
            overflow-y: auto;
        }
        .sidebar h2 {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 2rem;
            color: white;
        }
        .sidebar a {
            display: block;
            color: #cbd5e1;
            padding: 0.75rem 1rem;
            margin-bottom: 0.5rem;
            border-radius: 0.75rem;
            text-decoration: none;
        }
        .sidebar a:hover {
            background: #1e293b;
            color: white;
        }
        .main {
            margin-left: 280px;
            padding: 2rem;
        }
        .card {
            background: white;
            border-radius: 1.5rem;
            padding: 2rem;
            max-width: 700px;
            margin: 0 auto;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }
        h2 {
            font-size: 1.5rem;
            font-weight: 600;
            color: #0f172a;
            margin-bottom: 1.5rem;
        }
        input, select {
            width: 100%;
            padding: 0.85rem 1rem;
            margin-bottom: 1rem;
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            font-size: 0.95rem;
            background: #f8fafc;
        }
        input:focus, select:focus {
            outline: none;
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.2);
            background: white;
        }
        .video-item {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 0.5rem;
            align-items: center;
        }
        .video-item input {
            flex: 1;
            margin-bottom: 0;
        }
        .add-video {
            background: #10b981;
            margin-top: 0.5rem;
            margin-bottom: 1rem;
        }
        button {
            width: 100%;
            padding: 0.85rem;
            background: #4f46e5;
            color: white;
            border: none;
            border-radius: 1rem;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
        }
        button:hover {
            background: #4338ca;
        }
        .add-video:hover {
            background: #059669;
        }
        .msg {
            margin-top: 1rem;
            padding: 0.75rem;
            border-radius: 1rem;
            font-size: 0.85rem;
            text-align: center;
            display: none;
        }
        .success {
            background: #d1fae5;
            color: #065f46;
            display: block;
        }
        .error {
            background: #fee2e2;
            color: #b91c1c;
            display: block;
        }
        @media (max-width: 768px) {
            .sidebar {
                width: 100%;
                height: auto;
                position: relative;
                display: flex;
                flex-wrap: wrap;
                gap: 0.5rem;
                padding: 1rem;
                justify-content: center;
            }
            .sidebar h2 {
                width: 100%;
                text-align: center;
                margin-bottom: 0.75rem;
            }
            .sidebar a {
                display: inline-block;
                margin: 0 0.25rem;
                font-size: 0.85rem;
                padding: 0.5rem 0.75rem;
            }
            .main {
                margin-left: 0;
                padding: 1rem;
            }
            .card {
                margin: 0;
                padding: 1.5rem;
            }
            .video-item {
                flex-direction: column;
            }
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <h2>Administrador</h2>
        <a href="/Administrador/dashboard">Inicio</a>
        <a href="/Administrador/alta-profesor">Alta Profesor</a>
        <a href="/Administrador/alta-curso">Alta Curso</a>
        <a href="/Administrador/visualizaciones">Visualizaciones</a>
        <a href="/Administrador/calificaciones">Calificaciones</a>
        <a href="/Administrador/reportes">Reportes</a>
        <a href="http://localhost/plataforma/api.php?action=logout">Cerrar sesión</a>
    </div>
    <div class="main">
        <div class="card">
            <h2>Crear nuevo curso</h2>
            <form id="formCurso">
                <input type="text" name="nombre_curso" placeholder="Nombre del curso" required>
                <select name="profesor_id" id="profesorSelect" required>
                    <option value="">Seleccione profesor</option>
                </select>
                <div id="videosContainer">
                    <div class="video-item">
                        <input type="text" name="videos[]" placeholder="URL o título del video 1" required>
                    </div>
                </div>
                <button type="button" class="add-video" id="agregarVideo">Agregar otro video</button>
                <button type="submit">Guardar curso</button>
                <div id="mensaje" class="msg"></div>
            </form>
        </div>
    </div>
    <script>
        async function verificarSesionAdmin() {
    const resp = await fetch('http://localhost/plataforma/api.php?action=verificar_sesion', { credentials: 'include' });
    const data = await resp.json();
    if (!data.logged || data.rol !== 'admin') {
        window.location.href = '/';
        return false;
    }
    return true;
}


        async function cargarProfesores() {
const resp = await fetch('http://localhost/plataforma/api.php?action=listar_profesores', { credentials: 'include' });
            const data = await resp.json();
            const select = document.getElementById('profesorSelect');
            if (data.success) {
                data.profesores.forEach(p => {
                    const option = document.createElement('option');
                    option.value = p.id;
                    option.textContent = `${p.nombre} - ${p.especialidad}`;
                    select.appendChild(option);
                });
            }
        }
        document.getElementById('agregarVideo').addEventListener('click', () => {
            const container = document.getElementById('videosContainer');
            const div = document.createElement('div');
            div.className = 'video-item';
            div.innerHTML = `<input type="text" name="videos[]" placeholder="URL o título del video" required>`;
            container.appendChild(div);
        });
        const form = document.getElementById('formCurso');
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(form);
            const resp = await fetch('http://localhost/plataforma/api.php?action=alta_curso', {
                method: 'POST',
                body: formData,
                credentials: 'include'
            });
            const data = await resp.json();
            const msgDiv = document.getElementById('mensaje');
            msgDiv.className = 'msg';
            if (data.success) {
                msgDiv.classList.add('success');
                msgDiv.innerText = 'Curso creado con éxito';
                form.reset();
                document.getElementById('videosContainer').innerHTML = `<div class="video-item"><input type="text" name="videos[]" placeholder="URL o título del video 1" required></div>`;
            } else {
                msgDiv.classList.add('error');
                msgDiv.innerText = data.message || 'Error al crear curso';
            }
            msgDiv.style.display = 'block';
            setTimeout(() => {
                msgDiv.className = 'msg';
                msgDiv.style.display = 'none';
            }, 3000);
        });
        cargarProfesores();
    </script>
</body>
</html>