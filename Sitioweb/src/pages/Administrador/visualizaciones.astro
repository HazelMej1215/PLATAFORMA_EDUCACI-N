
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Visualizaciones de videos</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family: 'Inter', sans-serif; background:#f1f5f9; }
        .sidebar { width:260px; background:#0f172a; color:white; position:fixed; height:100vh; padding:1.5rem; }
        .sidebar a { display:block; color:#cbd5e1; padding:0.75rem; margin-bottom:0.5rem; border-radius:0.75rem; text-decoration:none; }
        .sidebar a:hover { background:#1e293b; color:white; }
        .main { margin-left:260px; padding:2rem; }
        .card { background:white; border-radius:1.5rem; padding:1.5rem; overflow-x:auto; }
        table { width:100%; border-collapse:collapse; min-width:500px; }
        th, td { padding:1rem; text-align:left; border-bottom:1px solid #e2e8f0; }
        th { background:#f8fafc; font-weight:600; }
        @media (max-width:768px) {
            .sidebar { width:100%; height:auto; position:relative; display:flex; flex-wrap:wrap; justify-content:center; gap:0.5rem; padding:1rem; }
            .sidebar a { display:inline-block; margin:0; font-size:0.85rem; padding:0.5rem 0.75rem; }
            .main { margin-left:0; padding:1rem; }
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <h2>Administrador</h2>
        <a href="/Administrador/dashboard">Inicio</a>
        <a href="/Administrador/alta-profesor">Alta Profesor</a>
        <a href="/Administrador/alta-curso">Alta Curso</a>
        <a href="/Administrador/visualizaciones">Visualizaciones</a>
        <a href="/Administrador/calificaciones">Calificaciones</a>
        <a href="/Administrador/reportes">Reportes</a>
        <a href="/api.php?action=logout">Cerrar sesión</a>
    </div>
    <div class="main">
        <div class="card">
            <h2>Visualizaciones por video</h2>
            <div id="contenido">Cargando...</div>
        </div>
    </div>
    <script>
        async function cargar() {
            const resp = await fetch('/api.php?action=visualizaciones_listado', { credentials: 'include' });
            const data = await resp.json();
            if (!data.success) {
                document.getElementById('contenido').innerHTML = '<p>Error al cargar datos</p>';
                return;
            }
            let html = `<table>`;
            html += `<thead><tr><th>Curso</th><th>Video</th><th>Orden</th><th>Visualizaciones</th></tr></thead><tbody>`;
            for (let v of data.visualizaciones) {
                html += `<tr>
                    <td>${v.curso}</td>
                    <td>${v.titulo}</td>
                    <td>${v.orden}</td>
                    <td>${v.visualizaciones}</td>
                </tr>`;
            }
            html += `</tbody></table>`;
            document.getElementById('contenido').innerHTML = html;
        }
        cargar();
    </script>
</body>
</html>