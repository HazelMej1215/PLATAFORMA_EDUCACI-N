<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mis Cursos | Plataforma Educativa</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Inter',sans-serif;background:#f8fafc;color:#0f172a}

.navbar{
background:#020617;
color:#fff;
padding:16px 32px;
display:flex;
justify-content:space-between;
align-items:center;
flex-wrap:wrap;
gap:10px
}

.navbar h2{font-size:18px;font-weight:600}
.navbar a{color:#94a3b8;text-decoration:none;margin-left:16px;font-size:14px;transition:.2s}
.navbar a:hover{color:#fff}

.wrapper{
max-width:1200px;
margin:40px auto;
padding:0 20px
}

.header{
margin-bottom:24px
}

.header h1{
font-size:24px;
font-weight:600;
margin-bottom:6px
}

.header p{
font-size:14px;
color:#64748b
}

.grid{
display:grid;
grid-template-columns:repeat(auto-fill,minmax(300px,1fr));
gap:24px
}

.course-card{
background:#fff;
border-radius:20px;
overflow:hidden;
transition:transform 0.2s, box-shadow 0.2s;
box-shadow:0 4px 6px -1px rgba(0,0,0,0.1);
border:1px solid #e2e8f0;
}
.course-card:hover{
transform:translateY(-5px);
box-shadow:0 20px 25px -5px rgba(0,0,0,0.1);
}
.course-image{
height:180px;
background:linear-gradient(135deg, #667eea, #764ba2);
display:flex;
align-items:center;
justify-content:center;
color:white;
font-size:3rem;
overflow:hidden;
}
.course-image img{
width:100%;
height:100%;
object-fit:cover;
}
.course-info{
padding:1.5rem;
}
.course-info h3{
font-size:1.2rem;
font-weight:600;
margin-bottom:0.5rem;
}
.course-meta{
display:flex;
justify-content:space-between;
align-items:center;
margin-top:1rem;
}
.btn{
background:#4f46e5;
color:white;
padding:0.5rem 1rem;
border-radius:0.75rem;
text-decoration:none;
font-size:0.85rem;
font-weight:500;
transition:.2s;
}
.btn:hover{
background:#4338ca;
}
.empty{
text-align:center;
color:#64748b;
padding:40px;
font-size:14px;
}
@media (max-width:768px){
.navbar{flex-direction:column;align-items:flex-start}
.grid{grid-template-columns:1fr}
}
/* Modo oscuro */
body.dark-theme{background:#0f172a;color:#e2e8f0}
body.dark-theme .navbar{background:#020617}
body.dark-theme .course-card{background:#1e293b;border-color:#334155}
body.dark-theme .course-info h3{color:#f1f5f9}
body.dark-theme .btn{background:#4f46e5}
</style>
</head>
<body>
<div class="navbar">
<h2>Plataforma Educativa</h2>
<div>
<a href="/Cliente/dashboard">Inicio</a>
<a href="/Cliente/perfil">Perfil</a>
<a href="/Cliente/cursos">Cursos</a>
<a href="/api.php?action=logout">Cerrar sesión</a>
</div>
</div>

<div class="wrapper">
<div class="header">
<h1>Mis cursos</h1>
<p>Accede a tus cursos disponibles y continúa tu aprendizaje</p>
</div>
<div id="listaCursos" class="grid"></div>
</div>

<script>
// Tema oscuro/claro
(function(){
    const applyTheme = (theme) => {
        if (theme === 'oscuro') {
            document.body.classList.add('dark-theme');
            document.body.classList.remove('light-theme');
        } else {
            document.body.classList.add('light-theme');
            document.body.classList.remove('dark-theme');
        }
        localStorage.setItem('theme', theme);
    };
    const saved = localStorage.getItem('theme');
    if (saved) applyTheme(saved);
    else {
        fetch('/api.php?action=obtener_tema', { credentials: 'include' })
            .then(r => r.json())
            .then(data => applyTheme(data.theme || 'claro'))
            .catch(() => applyTheme('claro'));
    }
})();

async function cargarCursos(){
    const resp = await fetch('/api.php?action=listar_cursos_cliente', { credentials: 'include' });
    const data = await resp.json();
    const cont = document.getElementById('listaCursos');
    if(!data.success || data.cursos.length===0){
        cont.innerHTML='<div class="empty">No hay cursos disponibles</div>';
        return;
    }
    let html = '';
    for(const curso of data.cursos){
        let imagenHtml = '';
        if(curso.imagen && curso.imagen.trim() !== ''){
            imagenHtml = `<img src="/uploads/cursos/${curso.imagen}" alt="${escapeHtml(curso.nombre)}">`;
        } else {
            imagenHtml = '<i class="fas fa-graduation-cap"></i>';
        }
        html += `
            <div class="course-card">
                <div class="course-image">${imagenHtml}</div>
                <div class="course-info">
                    <h3>${escapeHtml(curso.nombre)}</h3>
                    <div class="course-meta">
                        <a href="/Cliente/ver-curso?curso_id=${curso.id}" class="btn">Acceder al curso</a>
                    </div>
                </div>
            </div>
        `;
    }
    cont.innerHTML = html;
}
function escapeHtml(str){
    if(!str) return '';
    return str.replace(/[&<>]/g, function(m){
        if(m === '&') return '&amp;';
        if(m === '<') return '&lt;';
        if(m === '>') return '&gt;';
        return m;
    });
}
cargarCursos();
</script>
</body>
</html>