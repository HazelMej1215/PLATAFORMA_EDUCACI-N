---
// src/pages/Cliente/ver-curso.astro
// Esta página requiere recibir ?curso_id=1 en la URL
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Reproduciendo curso</title>
    <style>
        body { font-family: 'Inter', sans-serif; background:#f1f5f9; margin:0; }
        .navbar { background:#0f172a; color:white; padding:1rem; text-align:center; }
        .container { display:flex; max-width:1200px; margin:2rem auto; gap:2rem; flex-wrap:wrap; background:white; border-radius:1.5rem; padding:1.5rem; }
        .video-area { flex:2; }
        .video-area iframe { width:100%; height:400px; border-radius:1rem; }
        .lecciones { flex:1; background:#f8fafc; border-radius:1rem; padding:1rem; }
        .leccion { padding:0.75rem; margin-bottom:0.5rem; border-radius:0.5rem; cursor:pointer; }
        .leccion.bloqueada { background:#e2e8f0; color:#64748b; cursor:not-allowed; }
        .leccion.disponible { background:#dbeafe; color:#1e3a8a; }
        .leccion.vista { background:#d1fae5; color:#065f46; }
        button { background:#4f46e5; border:none; color:white; padding:0.5rem 1rem; border-radius:0.5rem; cursor:pointer; margin-top:1rem; }
        @media (max-width:768px) { .container { flex-direction:column; } }
    </style>
</head>
<body>
    <div class="navbar">
        <h2>Reproduciendo curso</h2>
        <a href="/Cliente/cursos" style="color:white;">← Volver a cursos</a>
    </div>
    <div class="container" id="app">
        <div class="video-area">
            <iframe id="player" src="" frameborder="0" allowfullscreen></iframe>
            <div id="completadoMsg"></div>
        </div>
        <div class="lecciones" id="listaLecciones">Cargando lecciones...</div>
    </div>
    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const cursoId = urlParams.get('curso_id');
        if (!cursoId) window.location.href = '/Cliente/cursos';

        let progreso = []; // array de {id, orden, visto}
        let videos = [];    // array de {id, titulo, url, orden}

        async function cargarProgreso() {
            const resp = await fetch(`http://localhost/plataforma/api.php?action=obtener_progreso&curso_id=${cursoId}`, { credentials: 'include' });
            const data = await resp.json();
            if (!data.success) return;
            progreso = data.progreso;
            // También necesitamos obtener los datos de los videos (títulos, URLs)
            const respVideos = await fetch(`http://localhost/plataforma/api.php?action=videos_curso&curso_id=${cursoId}`, { credentials: 'include' });
            const dataVideos = await respVideos.json();
            if (dataVideos.success) videos = dataVideos.videos;
            renderLecciones();
            // Determinar primer video no visto
            let primerNoVisto = videos.find(v => {
                let prog = progreso.find(p => p.id === v.id);
                return !prog || prog.visto === 0;
            });
            if (!primerNoVisto) primerNoVisto = videos[0];
            if (primerNoVisto) cargarVideo(primerNoVisto.id);
        }

        function renderLecciones() {
            let html = '<h3>Lecciones</h3>';
            for (let v of videos) {
                let prog = progreso.find(p => p.id === v.id);
                let estado = (prog && prog.visto === 1) ? 'vista' : (v.orden === 1 || (progreso.find(p => p.orden === v.orden-1 && p.visto === 1)) ? 'disponible' : 'bloqueada');
                let clase = `leccion ${estado}`;
                let click = (estado !== 'bloqueada') ? `onclick="cargarVideo(${v.id})"` : '';
                html += `<div class="${clase}" ${click}>${v.orden}. ${v.titulo}</div>`;
            }
            document.getElementById('listaLecciones').innerHTML = html;
        }

        async function cargarVideo(videoId) {
            const video = videos.find(v => v.id === videoId);
            if (!video) return;
            document.getElementById('player').src = video.url;
            // Marcar como visto si es el primero que se reproduce? Realmente se marca al terminar.
            // Para simplificar, agregamos un listener para marcar al final del video (no implementado aquí).
            // Simulación: botón "Marcar como visto" (requiere backend). Lo dejamos simple.
        }

        async function marcarVisto(videoId) {

            const resp = await fetch('http://localhost/plataforma/api.php?action=marcar_visto', {
                method: 'POST',
                headers: {'Content-Type':'application/json'},
                body: JSON.stringify({video_id: videoId}),
                credentials: 'include'
            });
            const data = await resp.json();
            if (data.success) cargarProgreso(); // refrescar
        }

        cargarProgreso();
    </script>
</body>
</html>