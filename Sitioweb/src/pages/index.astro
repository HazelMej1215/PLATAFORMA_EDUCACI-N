<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión | Plataforma Educativa</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }

        .login-wrapper {
            max-width: 1000px;
            width: 100%;
            background: white;
            border-radius: 2rem;
            box-shadow: 0 25px 45px -12px rgba(0, 0, 0, 0.25);
            overflow: hidden;
            display: flex;
            flex-wrap: wrap;
        }

        .info-panel {
            flex: 1;
            background: linear-gradient(145deg, #4f46e5, #7c3aed);
            padding: 2.5rem;
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .info-panel h1 {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 1rem;
            letter-spacing: -0.01em;
        }

        .info-panel p {
            font-size: 1rem;
            line-height: 1.5;
            opacity: 0.9;
            margin-bottom: 2rem;
        }

        .features {
            list-style: none;
        }

        .features li {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1rem;
            font-size: 0.95rem;
        }

        .features li::before {
            content: "✓";
            background: rgba(255, 255, 255, 0.2);
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }

        .form-panel {
            flex: 1;
            padding: 2.5rem;
            background: white;
        }

        .form-panel h2 {
            font-size: 1.8rem;
            font-weight: 600;
            color: #1f2937;
            margin-bottom: 0.5rem;
        }

        .form-panel .subtitle {
            color: #6b7280;
            margin-bottom: 2rem;
            font-size: 0.9rem;
        }

        .input-group {
            margin-bottom: 1.5rem;
        }

        .input-group label {
            display: block;
            font-size: 0.85rem;
            font-weight: 500;
            color: #374151;
            margin-bottom: 0.5rem;
        }

        .input-group input {
            width: 100%;
            padding: 0.85rem 1rem;
            border: 1px solid #e5e7eb;
            border-radius: 1rem;
            font-size: 0.95rem;
            transition: all 0.2s;
            background: #f9fafb;
            font-family: inherit;
        }

        .input-group input:focus {
            outline: none;
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.2);
            background: white;
        }

        button {
            width: 100%;
            padding: 0.85rem;
            background: #4f46e5;
            color: white;
            border: none;
            border-radius: 1rem;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s, transform 0.05s;
            font-family: inherit;
        }

        button:hover {
            background: #4338ca;
        }

        button:active {
            transform: scale(0.98);
        }

        .error-message {
            background: #fee2e2;
            color: #b91c1c;
            padding: 0.75rem;
            border-radius: 1rem;
            font-size: 0.85rem;
            margin-top: 1rem;
            text-align: center;
            border-left: 4px solid #ef4444;
        }

        .register-link {
            text-align: center;
            margin-top: 1.5rem;
            font-size: 0.85rem;
            color: #6b7280;
        }

        .register-link a {
            color: #4f46e5;
            text-decoration: none;
            font-weight: 600;
        }

        .register-link a:hover {
            text-decoration: underline;
        }

        @media (max-width: 720px) {
            .login-wrapper {
                flex-direction: column;
                border-radius: 1.5rem;
            }
            .info-panel {
                text-align: center;
                align-items: center;
            }
            .features li {
                justify-content: center;
            }
            .form-panel, .info-panel {
                padding: 1.8rem;
            }
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="info-panel">
            <h1>Aprende sin límites</h1>
            <p>Accede a cursos de alta calidad, certificados y una comunidad que impulsa tu carrera.</p>
            <ul class="features">
                <li>Más de 200 cursos</li>
                <li>Certificados digitales</li>
                <li>Modo oscuro y claro</li>
                <li>Progreso sincronizado</li>
            </ul>
        </div>
        <div class="form-panel">
            <h2>Bienvenido</h2>
            <div class="subtitle">Inicia sesión para continuar</div>
                <form id="loginForm" method="POST" action="http://localhost/plataforma/api.php?action=login">
            <div class="input-group">
                    <label for="email">Correo electrónico</label>
                    <input type="email" id="email" name="correo" placeholder="tú@ejemplo.com" required autocomplete="email">
                </div>
                <div class="input-group">
                    <label for="password">Contraseña</label>
                    <input type="password" id="password" name="contraseña" placeholder="••••••••" required autocomplete="current-password">
                </div>
                <button type="submit">Ingresar</button>
                <div id="errorMsg" class="error-message" style="display: none;"></div>
            </form>
            <div class="register-link">
                ¿No tienes cuenta? <a href="/registro">Regístrate gratis</a>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('loginForm');
            const errorDiv = document.getElementById('errorMsg');
            if (form) {
                form.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    errorDiv.style.display = 'none';
                    const formData = new FormData(form);
                    try {
                        const response = await fetch(form.action, { method: 'POST', body: formData,     credentials: 'include'   // ← Agregar esta línea
});
                        const result = await response.json();
                        if (result.success) {
                            window.location.href = result.redirect;
                        } else {
                            errorDiv.textContent = result.message || 'Credenciales incorrectas';
                            errorDiv.style.display = 'block';
                        }
                    } catch (error) {
                        errorDiv.textContent = 'Error de conexión con el servidor. Asegúrate de que XAMPP esté corriendo.';
                        errorDiv.style.display = 'block';
                    }
                });
            }
        });
    </script>
</body>
</html>